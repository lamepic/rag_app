# Copy to .env and adjust. Every variable is read by rag.config.Settings (prefix RAG_).
# Values below are the local defaults from `supabase start` and docker-compose.yml.

RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO

# Supabase Postgres (async driver for the app)
RAG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Redis from docker-compose.yml (database 0)
RAG_REDIS_URL=redis://127.0.0.1:6379/0
